{
  "name": "hms-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "node ./scripts/write-runtime-config.mjs && ng serve",
    "build": "node ./scripts/write-runtime-config.mjs && ng build",
    "build:ghpages": "node ./scripts/write-runtime-config.mjs && ng build --base-href /HMS/",
    "deploy:ghpages": "npm run build:ghpages && gh-pages -b gh-pages -d dist/hms-frontend/browser",
    "publish": "HMS_API_BASE_URL=https://gracie-diploic-cher.ngrok-free.dev/api/v1 npm run deploy:ghpages",
    "test": "ng test"
  },
  "dependencies": {
    "@angular/animations": "^19.2.0",
    "@angular/common": "^19.2.0",
    "@angular/compiler": "^19.2.0",
    "@angular/core": "^19.2.0",
    "@angular/forms": "^19.2.0",
    "@angular/platform-browser": "^19.2.0",
    "@angular/platform-browser-dynamic": "^19.2.0",
    "@angular/router": "^19.2.0",
    "rxjs": "^7.8.1",
    "tslib": "^2.8.1",
    "zone.js": "^0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.2.0",
    "@angular/cli": "^19.2.0",
    "@angular/compiler-cli": "^19.2.0",
    "@types/node": "^22.13.10",
    "gh-pages": "^6.3.0",
    "typescript": "^5.7.2"
  }
}
